{
  "name": "what-we-cant-see",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cinematic, interactive exploration of scale, discovery and the new instruments of seeing.",
  "author": "Adam Hickey",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-script.mjs && vite build",
    "check:script": "node scripts/check-script.mjs",
    "preview": "vite preview",
    "data:protein": "node scripts/fetch-protein.mjs",
    "data:galaxies": "node scripts/fetch-galaxies.mjs"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
